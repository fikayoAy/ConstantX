{
    "name": "constantx",
    "displayName": "ConstantX MCP",
    "description": "VS Code connector and status panel for the ConstantX MCP engineering workflow.",
    "version": "0.1.0",
    "publisher": "ConstantAx",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onCommand:constantx.startRuntime",
        "onCommand:constantx.stopRuntime",
        "onCommand:constantx.checkRuntime",
        "onCommand:constantx.connectProvider",
        "onCommand:constantx.openWorkflowPrompts",
        "onCommand:constantx.openStatusPanel",
        "onCommand:constantx.openRuntimeLogs",
        "onCommand:constantx.firstRunSetup",
        "onCommand:constantx.healthCheck"
    ],
    "main": "./src/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "constantx.startRuntime",
                "title": "ConstantX: Start Runtime"
            },
            {
                "command": "constantx.stopRuntime",
                "title": "ConstantX: Stop Runtime"
            },
            {
                "command": "constantx.checkRuntime",
                "title": "ConstantX: Check Runtime"
            },
            {
                "command": "constantx.connectProvider",
                "title": "ConstantX: Connect Provider"
            },
            {
                "command": "constantx.openWorkflowPrompts",
                "title": "ConstantX: Open Workflow Prompts"
            },
            {
                "command": "constantx.openStatusPanel",
                "title": "ConstantX: Open Status Panel"
            },
            {
                "command": "constantx.firstRunSetup",
                "title": "ConstantX: First Run Setup"
            },
            {
                "command": "constantx.healthCheck",
                "title": "ConstantX: Health Check"
            },
            {
                "command": "constantx.openRuntimeLogs",
                "title": "ConstantX: Open Runtime Logs"
            }
        ],
        "configuration": {
            "title": "ConstantX",
            "properties": {
                "constantx.host": {
                    "type": "string",
                    "default": "127.0.0.1",
                    "description": "Host for the shared ConstantX HTTP MCP runtime."
                },
                "constantx.port": {
                    "type": "number",
                    "default": 4317,
                    "description": "Port for the shared ConstantX HTTP MCP runtime."
                },
                "constantx.projectPath": {
                    "type": "string",
                    "default": "",
                    "description": "Planner project path for the status panel. Defaults to the active workspace folder."
                },
                "constantx.rootPath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional path to a ConstantX MCP server repository. Leave empty to use the bundled server inside the extension."
                },
                "constantx.nodePath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional Node.js executable used to start the ConstantX HTTP MCP runtime. Leave empty to use VS Code/Electron as Node."
                },
                "constantx.autoStart": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically start and supervise the shared ConstantX HTTP MCP runtime when VS Code starts."
                }
            }
        }
    },
    "scripts": {
        "check": "node --check src/extension.js && node --check src/runtime-manager.js && node --test tests/status-data.test.js tests/runtime-manager.test.js",
        "package": "node scripts/bundle-server.js && vsce package --baseImagesUrl https://raw.githubusercontent.com/fikayoAy/ConstantX/main --out ../dist-vsix/constantx-0.1.0.vsix",
        "bundle-server": "node scripts/bundle-server.js"
    },
    "license": "MIT",
    "devDependencies": {
        "@vscode/vsce": "^3.2.2"
    },
    "icon": "assets/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/fikayoAy/ConstantX.git"
    },
    "keywords": [
        "mcp",
        "codex",
        "constantx",
        "agent-workflow",
        "verification"
    ]
}
